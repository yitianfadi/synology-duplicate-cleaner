#!/bin/sh
# 本脚本由 DSM 套件框架以套件用户（duplicatecleaner）身份调用；目标路径可由环境变量覆盖。
PKG_NAME="DuplicateCleaner"
PKG_DIR="${SYNOPKG_PKGDEST:-/var/packages/${PKG_NAME}/target}"
VAR_DIR="${SYNOPKG_PKGVAR:-/var/packages/${PKG_NAME}/var}"

# 只创建数据目录，不覆盖已有配置/扫描报告/日志（升级时可保留历史）。
mkdir -p "$VAR_DIR" "$VAR_DIR/log" "$VAR_DIR/scans" "$VAR_DIR/deletions" "$VAR_DIR/plans" "$VAR_DIR/tmp" 2>/dev/null
chmod 700 "$VAR_DIR" 2>/dev/null
# 扫描结果与审计日志可能含文件路径，限制为套件用户可读写。
chmod 700 "$VAR_DIR/log" "$VAR_DIR/scans" "$VAR_DIR/deletions" "$VAR_DIR/plans" "$VAR_DIR/tmp" 2>/dev/null
rm -f "$VAR_DIR/backend.pid" 2>/dev/null
# 清理旧版本可能留下的字节码缓存，保证升级后加载新代码。
find "$PKG_DIR" -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null
echo "DuplicateCleaner postinst: data dir prepared at $VAR_DIR"
exit 0
